NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://localhost:27017/smart-hospital-queue

# Frontend origin(s) — used for CORS and password-reset links.
# Supports a single origin or comma-separated origins (without trailing slashes).
CLIENT_URL=http://localhost:5173

# Generate strong random secrets (must be distinct in production), e.g.: openssl rand -hex 64
ACCESS_TOKEN_SECRET=replace_with_a_long_random_access_secret
ACCESS_TOKEN_EXPIRY=15m

REFRESH_TOKEN_SECRET=replace_with_a_different_long_random_refresh_secret
REFRESH_TOKEN_EXPIRY=7d

# Optional cookie overrides for production deployments:
# COOKIE_SAME_SITE=none   # 'none' for cross-domain HTTPS (e.g. Vercel + Render), 'lax' for local HTTP dev
# COOKIE_SECURE=true      # true in HTTPS production, false in local HTTP dev
# COOKIE_PATH=/api/v1/auth
# COOKIE_DOMAIN=          # Leave blank unless sharing across custom subdomains (e.g. .upcharganga.com)

GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id

BCRYPT_SALT_ROUNDS=12

MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MINUTES=15
PASSWORD_RESET_EXPIRY_MINUTES=10

# Leave SMTP_HOST empty in development — emails will be logged to the console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=no-reply@upcharganga.com
