{
  "name": "smart-hospital-queue-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Smart Hospital Queue and Appointment Management System - Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --testPathPattern='(security|queue|auth)' --runInBand",
    "test:session": "node --test tests/auth.session.test.js",
    "test:security": "jest --testPathPattern=security.test.js --runInBand",
    "test:queue": "jest --testPathPattern=queue.scheduler.test.js --runInBand",
    "lint": "eslint src/ --fix || true"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^1.41.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^9.6.3",
    "helmet": "^8.2.0",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.3",
    "morgan": "^1.11.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^9.0.3",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
